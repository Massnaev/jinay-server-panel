# Public browser configuration only. Do not place secrets in variables prefixed with NEXT_PUBLIC_.
NEXT_PUBLIC_SERVERPANEL_API_BASE=/api

# Agent values belong in /etc/serverpanel/serverpanel.env on Ubuntu.
SERVERPANEL_LISTEN=127.0.0.1:9080
SERVERPANEL_DATA_DIR=/var/lib/serverpanel
SERVERPANEL_SECURE_COOKIES=true
SERVERPANEL_ENABLE_DOCKER_ACTIONS=false
